{
  "name": "nextts-tailwind-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "NODE_OPTIONS=--max_old_space_size=4096 next",
    "prepare": "husky install",
    "lint": "next lint",
    "format": "prettier --write .",
    "postbuild": "next-sitemap",
    "eslint:fix": "yarn eslint src --fix"
  },
  "dependencies": {
    "@headlessui/react": "^1.4.1",
    "@react-icons/all-files": "^4.1.0",
    "autoprefixer": "^10.3.3",
    "axios": "^1.13.2",
    "clsx": "^1.1.1",
    "firebase": "^12.5.0",
    "firebase-admin": "^13.6.0",
    "formik": "^2.2.9",
    "lodash": "^4.17.21",
    "moment": "^2.29.1",
    "next": "^16.0.1",
    "next-connect": "^0.11.1",
    "postcss": "^8.3.6",
    "react": "^18.1.0",
    "react-autosuggest": "^10.1.0",
    "react-dom": "^18.1.0",
    "react-icons": "^4.3.1",
    "react-loading-skeleton": "^3.0.3",
    "swr": "^1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.3.3",
    "@tailwindcss/line-clamp": "^0.2.1",
    "@types/lodash": "^4.14.172",
    "@types/react": "^17.0.19",
    "@types/react-autosuggest": "^10.1.5",
    "@types/tailwindcss": "^2.2.1",
    "@typescript-eslint/eslint-plugin": "^4.29.3",
    "@typescript-eslint/parser": "^4.31.0",
    "eslint": "^7.32.0",
    "eslint-config-next": "^11.1.0",
    "husky": "^7.0.2",
    "lint-staged": "^11.1.2",
    "next-sitemap": "^1.6.164",
    "prettier": "^2.3.0",
    "tailwindcss": "^2.2.8",
    "typescript": "^4.3.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,md,mdx}": [
      "yarn eslint src --max-warnings=0",
      "yarn format"
    ]
  }
}
